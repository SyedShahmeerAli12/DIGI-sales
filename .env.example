# Used by docker-compose.yml to bake the backend URL into the frontend build.
# On the VPS, set this to the HTTPS domain Caddy serves (see SITE_DOMAIN below) —
# mic/voice input requires a secure context (HTTPS), plain HTTP won't work.
BACKEND_PUBLIC_URL=https://your-domain.example.com

# The public hostname Caddy auto-provisions a free trusted Let's Encrypt cert for.
# Point an A record for this hostname at the VPS's IP, and make sure ports 80+443
# are free on the VPS (not already used by another web server/container).
SITE_DOMAIN=your-domain.example.com
