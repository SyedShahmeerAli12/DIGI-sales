# Used by docker-compose.yml to bake the backend URL into the frontend build.
# HTTPS is served by an existing nginx reverse proxy on the VPS (not by this
# project) — mic/voice input requires a secure context (HTTPS), plain HTTP
# won't work. Set this to that HTTPS domain.
BACKEND_PUBLIC_URL=https://your-domain.example.com

# The public hostname the VPS's existing nginx serves this app on.
SITE_DOMAIN=your-domain.example.com
